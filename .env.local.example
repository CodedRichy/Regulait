# Regulait is a fully static, client-side app. There are no server-side
# secrets -- LLM API keys are bring-your-own-key (BYOK) and are entered by
# each user in the app's Settings page, stored only in their own browser's
# localStorage.
#
# The only env var used is the metadata base URL for Open Graph tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000
